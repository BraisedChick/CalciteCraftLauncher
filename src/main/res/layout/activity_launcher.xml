<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/background_light"
    android:weightSum="10">

    <!-- 左侧：品牌/标题区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#8a1f1f38">

        <com.minecraft.ui.MioTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minecraft"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="启动器 · 1.8 - 1.26"
            android:textSize="14sp"
            android:textColor="#666688"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by ProtocolCraft"
            android:textSize="11sp"
            android:textColor="#444466"
            android:layout_marginTop="24dp" />

    </LinearLayout>

    <!-- 右侧：表单区域 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7"
        android:padding="24dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 登录卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <com.minecraft.ui.MioTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="登录"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgLoginType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbOffline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="离线登录"
                        android:textColor="#ffffff"
                        android:checked="true"
                        android:padding="8dp" />

                    <RadioButton
                        android:id="@+id/rbPremium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="正版登录"
                        android:textColor="#ffffff"
                        android:enabled="false"
                        android:alpha="0.5"
                        android:padding="8dp" />
                </RadioGroup>

                <com.minecraft.ui.MioEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="用户名"
                    android:textColorHint="#555555"
                    android:padding="12dp"
                    android:maxLines="1"
                    android:inputType="text" />
            </LinearLayout>

            <!-- 设置卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <com.minecraft.ui.MioTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.minecraft.ui.MioTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="游戏版本"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical" />

                    <Spinner
                        android:id="@+id/spinnerVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.minecraft.ui.MioTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="渲染器"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical" />

                    <RadioGroup
                        android:id="@+id/rgRenderer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOpenGL"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OpenGL ES"
                            android:textColor="#ffffff"
                            android:checked="true"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbVulkan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vulkan"
                            android:textColor="#ffffff"
                            android:enabled="false"
                            android:alpha="0.5"
                            android:padding="4dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- 启动按钮 -->
            <com.minecraft.ui.MioButton
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="启动游戏"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
