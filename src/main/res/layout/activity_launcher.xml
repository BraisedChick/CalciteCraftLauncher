<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/background_light">

    <!-- 左侧菜单栏 -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:background="@drawable/bg_left_menu"
        android:layout_marginVertical="12dp"
        android:layout_marginStart="8dp">

        <com.calcite.ui.MioButton
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="主页"
            android:textSize="10sp"
            android:layout_marginBottom="12dp"
            app:mioShape="oval" />

        <com.calcite.ui.MioButton
            android:id="@+id/btnAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="账号"
            android:textSize="10sp"
            android:layout_marginBottom="12dp"
            app:mioShape="oval" />

        <com.calcite.ui.MioButton
            android:id="@+id/btnVersion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="版本"
            android:textSize="10sp"
            android:layout_marginBottom="12dp"
            app:mioShape="oval" />

        <com.calcite.ui.MioButton
            android:id="@+id/btnRenderer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="渲染"
            android:textSize="10sp"
            app:mioShape="oval" />

    </LinearLayout>

    <!-- 右侧区域：内容 + 启动面板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_margin="12dp"
        android:layout_marginStart="4dp"
        android:weightSum="5">

        <!-- 中间内容区 (4/5) -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <include
                android:id="@+id/pageHome"
                layout="@layout/page_home" />

            <include
                android:id="@+id/pageAccount"
                layout="@layout/page_account"
                android:visibility="gone" />

            <include
                android:id="@+id/pageVersion"
                layout="@layout/page_version"
                android:visibility="gone" />

            <include
                android:id="@+id/pageRenderer"
                layout="@layout/page_renderer"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 右侧启动面板 (1/5) -->
        <LinearLayout
            android:id="@+id/launchPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_right_panel"
            android:padding="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.calcite.ui.MioTextView
                android:id="@+id/panelDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.calcite.ui.MioTextView
                android:id="@+id/panelLoginType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="离线登录"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <com.calcite.ui.MioButton
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="启动游戏"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="#444466"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.calcite.ui.MioTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="版本"
                    android:textSize="10sp" />

                <com.calcite.ui.MioTextView
                    android:id="@+id/panelVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.18"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <com.calcite.ui.MioTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="渲染"
                    android:textSize="10sp" />

                <com.calcite.ui.MioTextView
                    android:id="@+id/panelRenderer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenGL"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
