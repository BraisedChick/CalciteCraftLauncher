<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_white_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Microsoft 正版登录"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- 登录进度/状态 -->
    <TextView
        android:id="@+id/tvAuthStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在初始化..."
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- 设备代码显示区域（登录初始阶段可见） -->
    <LinearLayout
        android:id="@+id/layoutDeviceCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请在浏览器中访问以下链接，并输入代码："
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- 验证网址 -->
        <TextView
            android:id="@+id/tvVerificationUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="https://microsoft.com/link"
            android:textColor="#1a73e8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/edittext_bg"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />

        <!-- 用户代码 -->
        <TextView
            android:id="@+id/tvUserCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="XXXX-XXXX"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:background="@drawable/edittext_bg"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />

        <!-- 复制按钮 -->
        <Button
            android:id="@+id/btnCopyCode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="复制代码并打开浏览器"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:backgroundTint="#1a73e8"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progressAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:indeterminate="true" />

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCancelAuth"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="取消"
            android:textColor="#666666"
            android:backgroundTint="#f0f0f0" />

    </LinearLayout>

</LinearLayout>
