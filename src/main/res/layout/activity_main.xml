<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 渲染表面（始终可见，菜单和游戏都通过 OpenGL 渲染） -->
    <com.minecraft.RendererSurfaceView
        android:id="@+id/gameSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 虚拟摇杆（左侧，游戏中可见） -->
    <FrameLayout
        android:id="@+id/joystickContainer"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:visibility="gone">

        <View
            android:id="@+id/joystickBase"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/joystick_base"/>

        <View
            android:id="@+id/joystickKnob"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/joystick_knob"/>

    </FrameLayout>

    <!-- 上升/下降按钮（右侧，游戏中可见） -->
    <LinearLayout
        android:id="@+id/elevationButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnUp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="↑"
            android:textSize="24sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="↓"
            android:textSize="24sp" />
    </LinearLayout>

</FrameLayout>
